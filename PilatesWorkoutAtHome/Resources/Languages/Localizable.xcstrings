    "(Điều chỉnh độ rộng để thay đổi độ dốc của đường cong)": {
      "comment": "Một chú thích nhỏ dưới phần điều chỉnh độ rộng của đường cong.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "(Ajuste el ancho para cambiar la pendiente de la curva)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "(Ajustez la largeur pour modifier la pente de la courbe)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "(कर्व की ढलान बदलने के लिए चौड़ाई समायोजित करें)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "(曲線の傾きを変更するには幅を調整します)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "(곡선의 기울기를 변경하려면 너비를 조정하십시오)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "new",
            "value": "(Điều chỉnh độ rộng để thay đổi độ dốc của đường cong)"
          }
        }
      }
    },
