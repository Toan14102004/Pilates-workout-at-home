    "Leaving without saving will discard all changes made." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlassen ohne zu speichern verwirft alle vorgenommenen Änderungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salir sin guardar descartará todos los cambios realizados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitter sans enregistrer annulera toutes les modifications effectuées"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना सहे छो़ड़ने पर की गई सभी परिवर्तनों को हटा दिया जाएगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存せずに終了すると、すべての変更が破棄されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하지 않고 나가면 모든 변경 내용이 삭제됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sair sem salvar descartará todas as alterações feitas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sair sem salvar irá descompactar todas as alterações feitas."
